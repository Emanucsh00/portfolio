PORT=3000
NODE_ENV=development
DATABASE_URL=
DB_DIALECT=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=secret
DB_SYNC_ALTER=true
TRUST_PROXY=false
REQUIRE_FIREBASE_EMAIL_VERIFIED=false
AUTH_CHECK_FIREBASE_REVOKED=false
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=8h
JWT_SETUP_EXPIRES_IN=15m
CRYPTO_SECRET=change_this_crypto_secret
CORS_ORIGIN=http://localhost:5173,http://localhost:9000
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portfolio <no-reply@example.com>"
GITHUB_USERNAME=
GITHUB_TOKEN=
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_NAME=Portfolio Admin
DEFAULT_ADMIN_FIREBASE_UID=
AUTH_CHALLENGE_TTL_MINUTES=10
AUTH_OTP_TTL_MINUTES=5
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_TOTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_MAX=3
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_TOTP_SETUP_TTL_MINUTES=10
AUTH_CHALLENGE_STRICT_IP=false
